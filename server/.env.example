# ==============================================================================
# FixMyRoad Backend Environment Configuration
# Copy this file to .env and configure values before starting server or deploying.
# ==============================================================================

# Server Runtime Setup
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.fewtccs.mongodb.net/fixmyroad?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_production_jwt_key_here
JWT_EXPIRES_IN=1d
COOKIE_EXPIRES_IN=1

# Frontend Origin URL (supports comma-separated origins for production)
# Example: https://fixmyroad.vercel.app,https://www.fixmyroad.com
CLIENT_URL=http://localhost:5173

# Cloudinary Storage Configuration (for road defect images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Microservice Setup (optional)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=3000

# ==============================================================================
# Email & OTP Notification Setup (CRITICAL FOR LIVE CITIZEN REGISTRATION & RESET)
# ==============================================================================
# Delivery Modes:
#   - 'smtp' or 'real': Dispatches live emails using SMTP credentials below.
#   - 'mock': Logs OTP codes to terminal console (ideal for local testing).
# Note: If valid SMTP_USER and SMTP_PASSWORD are provided, SMTP mode is auto-selected.
NOTIFICATION_DELIVERY_MODE=mock

# --- GMAIL SMTP SETUP GUIDE ---
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Go to "App passwords" (search "App passwords" in Google account security settings)
# 3. Create a new app password for "FixMyRoad"
# 4. Copy the generated 16-character password and paste below as SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
NOTIFICATION_FROM_EMAIL=your_email@gmail.com
NOTIFICATION_FROM_NAME=FixMyRoad System

# Rate Limits (requests per window)
MUNICIPALITY_STATUS_RATE_LIMIT=60
FEEDBACK_RATE_LIMIT=20
REOPEN_RATE_LIMIT=10
ANALYTICS_RATE_LIMIT=60
ANALYTICS_RATE_WINDOW_MS=3600000
HEALTH_RATE_LIMIT=120
HEALTH_RATE_WINDOW_MS=3600000
EXPORT_RATE_LIMIT=20
EXPORT_RATE_WINDOW_MS=3600000

# Security & Limits
ANALYTICS_MAX_RANGE_DAYS=366
MAX_EXPORT_RECORDS=10000
SLOW_REQUEST_THRESHOLD_MS=1000
ENABLE_API_DOCS=false

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

